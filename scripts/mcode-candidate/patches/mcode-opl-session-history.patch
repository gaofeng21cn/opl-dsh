+      historyRevision: 'hist-9',
+      displayRevision: 'disp-9',
+    }));
+    const runtime = createRuntime({ rewindSession });
+    const { call } = register(runtime);
+    const result = await call('opl/session/history/rewind', {
+      sessionId: 'sess-1',
+      userMessageId: 'msg-user-v1-a',
+      clientRequestId: 'edit-1',
+      rewindTurnDiff: false,
+    });
+    expect(rewindSession).toHaveBeenCalledTimes(1);
+    expect(rewindSession).toHaveBeenCalledWith({
+      sessionId: 'sess-1',
+      userMessageId: 'msg-user-v1-a',
+      clientRequestId: normalizeMutationOperationId('sess-1', 'edit-1'),
+      rewindTurnDiff: false,
+    });
+    expect(result).toMatchObject({
+      version: 1,
+      rewound: true,
