+
+describe('opl session boundary tracker', () => {
+  it('reads the operation identity from prompt _meta', () => {
+    expect(readOplClientRequestId({ [OPL_CLIENT_REQUEST_ID_META_KEY]: 'op-1' })).toBe('op-1');
+    expect(readOplClientRequestId({ [OPL_CLIENT_REQUEST_ID_META_KEY]: '  op-2  ' })).toBe('op-2');
+    expect(readOplClientRequestId({})).toBeUndefined();
+    expect(readOplClientRequestId(undefined)).toBeUndefined();
+    expect(readOplClientRequestId(null)).toBeUndefined();
+    expect(readOplClientRequestId({ [OPL_CLIENT_REQUEST_ID_META_KEY]: 42 })).toBeUndefined();
+  });
+
+  it('binds the admitted turn to the committed user message and notifies once', () => {
+    const tracker = new OplSessionBoundaryTracker();
+    tracker.track('sess-1', 'turn-1', 'initial');
+    const boundary = tracker.resolve('sess-1', { id: 'msg-user-v1-a', turnId: 'turn-1', role: 'user' });
+    expect(boundary).toEqual({
+      sessionId: 'sess-1',
+      clientRequestId: 'initial',
+      userMessageId: 'msg-user-v1-a',
+      turnId: 'turn-1',
+    });
+    expect(tracker.has('sess-1', 'initial')).toBe(true);
+    // A replayed or duplicate stream frame must not produce a second mapping.
+    expect(
+      tracker.resolve('sess-1', { id: 'msg-user-v1-a', turnId: 'turn-1', role: 'user' }),
+    ).toBeUndefined();
+  });
+
+  it('gives two sessions using the same request id independent boundaries', () => {
+    const tracker = new OplSessionBoundaryTracker();
+    tracker.track('sess-1', 'turn-1', 'initial');
+    tracker.resolve('sess-1', { id: 'msg-user-v1-a', turnId: 'turn-1', role: 'user' });
+    // The second session reuses the same request id; it must not be swallowed.
+    tracker.track('sess-2', 'turn-2', 'initial');
+    const second = tracker.resolve('sess-2', { id: 'msg-user-v1-b', turnId: 'turn-2', role: 'user' });
+    expect(second).toEqual({
+      sessionId: 'sess-2',
+      clientRequestId: 'initial',
+      userMessageId: 'msg-user-v1-b',
+      turnId: 'turn-2',
+    });
+    expect(tracker.has('sess-1', 'initial')).toBe(true);
+    expect(tracker.has('sess-2', 'initial')).toBe(true);
+  });
+
+  it('ignores injected and automatic continuation messages', () => {
+    const tracker = new OplSessionBoundaryTracker();
+    tracker.track('sess-1', 'turn-1', 'op-1');
+    expect(
+      tracker.resolve('sess-1', { id: 'msg-assistant-v1-a', turnId: 'turn-1', role: 'assistant' }),
+    ).toBeUndefined();
+    expect(
+      tracker.resolve('sess-1', { id: 'msg-system-v1-a', turnId: 'turn-1', role: 'system' }),
+    ).toBeUndefined();
+    expect(
+      tracker.resolve('sess-1', { id: 'msg-user-v1-auto', turnId: 'turn-auto', role: 'user' }),
+    ).toBeUndefined();
+    expect(tracker.has('sess-1', 'op-1')).toBe(false);
+    expect(
+      tracker.resolve('sess-1', { id: 'msg-user-v1-a', turnId: 'turn-1', role: 'user' }),
+    ).toMatchObject({ clientRequestId: 'op-1', userMessageId: 'msg-user-v1-a' });
+  });
+
+  it('never binds by content, timestamp or ordering', () => {
+    const tracker = new OplSessionBoundaryTracker();
+    tracker.track('sess-1', 'turn-1', 'op-1');
+    expect(
+      tracker.resolve('sess-1', { id: 'msg-user-v1-x', turnId: 'turn-2', role: 'user' }),
+    ).toBeUndefined();
+    expect(tracker.resolve('sess-1', { turnId: 'turn-1', role: 'user' })).toBeUndefined();
+    expect(tracker.resolve('sess-1', { id: 'msg-user-v1-a', role: 'user' })).toBeUndefined();
+  });
+
+  it('keeps a second follow-up prompt independent from the first', () => {
+    const tracker = new OplSessionBoundaryTracker();
+    tracker.track('sess-1', 'turn-a', 'op-1');
+    tracker.track('sess-1', 'turn-b', 'op-2');
+    expect(
+      tracker.resolve('sess-1', { id: 'msg-user-v1-b', turnId: 'turn-b', role: 'user' }),
+    ).toMatchObject({ clientRequestId: 'op-2', userMessageId: 'msg-user-v1-b' });
+    expect(
+      tracker.resolve('sess-1', { id: 'msg-user-v1-a', turnId: 'turn-a', role: 'user' }),
+    ).toMatchObject({ clientRequestId: 'op-1', userMessageId: 'msg-user-v1-a' });
+  });
+});
