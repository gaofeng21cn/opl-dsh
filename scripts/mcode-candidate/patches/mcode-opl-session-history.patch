+      deletedMessageIds: ['msg-user-v1-b', 'msg-assistant-v1-b'],
+      historyRevision: 'hist-9',
+      displayRevision: 'disp-9',
+    });
+    expect(runtime).not.toHaveProperty('editSessionMessage');
+  });
+
+  it('replays the recorded result after the boundary was deleted, mutating once', async () => {
+    const { runtime, mutations, messages } = createStatefulRewindRuntime();
+    const { call } = register(runtime);
+    const request = {
+      sessionId: 'sess-1',
+      userMessageId: 'msg-user-v1-a',
+      clientRequestId: 'edit-1',
+      rewindTurnDiff: false,
+    };
+    const first = await call('opl/session/history/rewind', request);
