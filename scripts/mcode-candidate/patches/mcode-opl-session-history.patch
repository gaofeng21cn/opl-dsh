+    const replay = await call('opl/session/history/rewind', request);
+    expect(replay).toMatchObject({
+      rewound: true,
+      clientRequestId: 'edit-1',
+      deletedMessageIds: ['msg-user-v1-a', 'msg-user-v1-b', 'msg-assistant-v1-a'],
+      historyRevision: 'hist-2',
