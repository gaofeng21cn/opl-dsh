+import * as acp from '@agentclientprotocol/sdk';
+import { describe, expect, it, vi } from 'vitest';
+
+import { createTuiAcpAgent } from '../../src/acp/agent.js';
+import type { TuiAcpRuntime } from '../../src/acp/runtime.js';
+import {
+  normalizeMutationOperationId,
+  oplSessionHistoryCapabilities,
+} from '../../src/acp/session-history-extension.js';
+import type { TuiStreamEvent } from '../../src/runtime/stream-events.js';
+
+/** Stream mirroring the real Runtime: committed user message first, then output. */
+function committedUserStream(turnId: string, userMessageId: string): TuiStreamEvent[] {
+  return [
+    { type: 'message', message: { id: userMessageId, turnId, role: 'user', content: 'hello' } },
+    {
+      type: 'message',
+      message: { id: `msg-assistant-${turnId}`, turnId, role: 'assistant', content: 'hi' },
+    },
+    { type: 'done', turnId },
+  ];
+}
+
+function createRuntime(options: {
+  eventsFor?: (turnId: string) => readonly TuiStreamEvent[];
+  /** Holds the run open until the returned gate resolves (or the prompt aborts). */
+  holdRunUntilRelease?: boolean;
+  summaries?: {
+    userMessageId: string;
+    contentHead?: string;
+    timestamp: number;
+    fileChangeCount: number;
+  }[];
+}) {
+  const eventsFor = options.eventsFor ?? (() => []);
+  let releaseRun: (() => void) | undefined;
+  const runGate = options.holdRunUntilRelease
+    ? new Promise<void>((resolve) => {
+        releaseRun = resolve;
+      })
+    : Promise.resolve();
+  const sendMessage = vi.fn(async function* sendMessage(req: { turnId: string }, signal?: AbortSignal) {
+    for (const event of eventsFor(req.turnId)) yield event;
+    if (!options.holdRunUntilRelease) return;
+    // Mirror the official harness: a cancelled run stops instead of hanging.
+    await Promise.race([
+      runGate,
+      new Promise<void>((resolve) => {
+        if (!signal) return;
+        if (signal.aborted) resolve();
+        else signal.addEventListener('abort', () => resolve(), { once: true });
+      }),
+    ]);
+  });
+  const runtime = {
+    isGoalEnabled: () => false,
+    listSessions: vi.fn(async () => []),
+    listSessionPage: vi.fn(async () => ({ sessions: [], hasMore: false })),
+    getSession: vi.fn(async (sessionId: string) => ({ sessionId, workspaceDir: '/workspace' })),
+    getMessages: vi.fn(async () => []),
+    listMessagePage: vi.fn(async () => ({ messages: [], hasMore: false })),
+    createSession: vi.fn(async ({ workspaceDir }: { workspaceDir: string }) => ({
+      sessionId: 'session-1',
+      workspaceDir,
+    })),
+    clearSessionMcpServers: vi.fn(async () => undefined),
+    configureSessionMcpServers: vi.fn(async () => undefined),
+    deleteSession: vi.fn(async () => undefined),
+    listSessionInputSummaries: vi.fn(async () => options.summaries ?? []),
+    rewindSession: vi.fn(async () => ({ rewound: true, deletedMessageIds: [] })),
+    getAccountStatus: vi.fn(async () => ({ status: 'ready' as const, warnings: [] })),
+    getRuntimeDiagnostics: vi.fn(async () => ({ warnings: [] })),
+    listModels: vi.fn(async () => []),
+    selectModel: vi.fn(async () => true),
+    getPermissionMode: vi.fn(async () => 'default'),
+    setPermissionMode: vi.fn(async () => 'default'),
+    getPlanModeCapabilities: vi.fn(async () => ({ entryEnabled: true })),
+    getContextSnapshot: vi.fn(async () => ({ status: 'empty' })),
+    getSessionUsage: vi.fn(async () => ({})),
