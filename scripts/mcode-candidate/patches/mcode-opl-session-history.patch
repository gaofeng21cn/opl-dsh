+      { rewindFiles: true },
+      { restoreFiles: true },
+      { files: true },
+      { scope: 'conversation_and_files' },
+      { rewindTurnDiffs: true },
+    ]) {
+      await expect(
+        call('opl/session/history/rewind', {
+          sessionId: 'sess-1',
+          userMessageId: 'msg-user-v1-a',
+          clientRequestId: 'edit-1',
+          ...params,
+        }),
+      ).rejects.toBeInstanceOf(acp.RequestError);
+    }
+    expect(rewindSession).not.toHaveBeenCalled();
+  });
+
+  it('rejects an unknown boundary and never claims a rewind happened', async () => {
+    const { runtime, mutations } = createStatefulRewindRuntime();
+    const { call } = register(runtime);
+    await expect(
+      call('opl/session/history/rewind', {
+        sessionId: 'sess-1',
+        userMessageId: 'msg-user-v1-missing',
+        clientRequestId: 'edit-missing',
+        rewindTurnDiff: false,
+      }),
+    ).rejects.toBeInstanceOf(acp.RequestError);
+    expect(mutations()).toBe(0);
+  });
+
+  it('never reports a successful rewind when the runtime declines', async () => {
+    const runtime = createRuntime({ rewindSession: vi.fn(async () => ({ rewound: false })) });
+    const { call } = register(runtime);
+    await expect(
+      call('opl/session/history/rewind', {
+        sessionId: 'sess-1',
+        userMessageId: 'msg-user-v1-a',
+        clientRequestId: 'edit-1',
+        rewindTurnDiff: false,
+      }),
+    ).rejects.toBeInstanceOf(acp.RequestError);
+  });
+
+  it('does not reflect private Runtime diagnostics on rewind', async () => {
+    const canary = 'SYNTHETIC_PRIVATE_VALUE_0714';
+    const runtime = createRuntime({
+      rewindSession: vi.fn(async () => {
+        throw Object.assign(new Error(canary), { code: 'MESSAGE_BOUNDARY_INVALID' });
+      }),
+    });
+    const { call } = register(runtime);
+    const failure = await call('opl/session/history/rewind', {
+      sessionId: 'sess-1',
+      userMessageId: 'msg-user-v1-a',
+      clientRequestId: 'edit-1',
+      rewindTurnDiff: false,
+    }).catch((error: unknown) => error);
+    expect(failure).toBeInstanceOf(acp.RequestError);
+    const text = `${(failure as Error).message}${(failure as Error).stack ?? ''}`;
+    expect(text).not.toContain(canary);
+    // A known code still maps to stable public wording.
+    expect((failure as Error).message).toMatch(/not a rewindable conversation boundary/);
+  });
+
+  it('does not reflect private Runtime diagnostics with an unknown code', async () => {
+    const canary = 'ANOTHER_PRIVATE_0714';
+    const runtime = createRuntime({
+      rewindSession: vi.fn(async () => {
+        throw Object.assign(new Error(canary), { code: 'SOME_INTERNAL_CODE' });
+      }),
+    });
+    const { call } = register(runtime);
+    const failure = await call('opl/session/history/rewind', {
+      sessionId: 'sess-1',
+      userMessageId: 'msg-user-v1-a',
+      clientRequestId: 'edit-1',
+      rewindTurnDiff: false,
