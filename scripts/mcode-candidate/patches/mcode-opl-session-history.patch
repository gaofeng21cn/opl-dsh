+import { describe, expect, it, vi } from 'vitest';
+
+import * as acp from '@agentclientprotocol/sdk';
+
+import {
+  OPL_CLIENT_REQUEST_ID_META_KEY,
+  OPL_SESSION_HISTORY_META_KEY,
+  OPL_SESSION_HISTORY_NOTIFICATIONS,
+  OplSessionBoundaryTracker,
+  normalizeMutationOperationId,
+  oplSessionHistoryCapabilities,
+  readOplClientRequestId,
+  registerTuiAcpSessionHistoryExtension,
+  type SessionHistoryInputSummary,
+  type SessionHistoryRuntime,
+} from '../../src/acp/session-history-extension.js';
+
+type ParamsParserLike = { parse: (params: unknown) => unknown };
+type HandlerLike = (context: never) => unknown;
+
+function createApp() {
+  const handlers = new Map<string, { parser: ParamsParserLike; handler: HandlerLike }>();
+  return {
+    handlers,
+    onRequest: (method: string, parser: ParamsParserLike, handler: HandlerLike) => {
+      handlers.set(method, { parser, handler });
+    },
+  };
+}
+
+function createRuntime(
+  overrides: Partial<SessionHistoryRuntime> = {},
+): SessionHistoryRuntime {
+  return {
+    listSessionInputSummaries: vi.fn(async () => []),
+    rewindSession: vi.fn(async () => ({ rewound: true, deletedMessageIds: [] })),
+    ...overrides,
+  } as SessionHistoryRuntime;
+}
+
+/**
+ * Stateful fake of the official mutation contract, mirroring the real order in
+ * `conversation-rewind-edit-service.rewind`: the recorded result for a completed
+ * operation is returned before the boundary is ever looked up. A rewind removes
+ * the target message and everything after it, so a later *fresh* request against
+ * that boundary fails exactly as `planInclusive` does.
+ */
+function createStatefulRewindRuntime(existing = ['msg-user-v1-a', 'msg-user-v1-b']) {
+  const completed = new Map<string, unknown>();
+  const messages = [...existing];
+  let mutations = 0;
+  const runtime = createRuntime({
+    rewindSession: vi.fn(async (input) => {
+      const recorded = completed.get(input.clientRequestId);
+      if (recorded) return recorded as never;
+      const at = messages.indexOf(input.userMessageId);
+      if (at < 0) {
+        throw Object.assign(new Error('Rewind target user message not found'), {
+          code: 'MESSAGE_BOUNDARY_INVALID',
+        });
+      }
+      const deleted = messages.splice(at);
+      mutations += 1;
+      const result = {
+        rewound: true,
+        deletedMessageIds: [...deleted, 'msg-assistant-v1-a'],
+        historyRevision: 'hist-2',
+        displayRevision: 'disp-2',
+      };
+      completed.set(input.clientRequestId, result);
+      return result as never;
+    }),
+  });
+  return { runtime, mutations: () => mutations, messages: () => [...messages] };
+}
+
+function summaries(): SessionHistoryInputSummary[] {
+  return [
+    {
+      userMessageId: 'msg-user-v1-a',
+      contentHead: 'first question',
+      timestamp: 1,
+      fileChangeCount: 0,
+    },
+    {
+      userMessageId: 'msg-user-v1-b',
+      timestamp: 2,
+      fileChangeCount: 3,
+      assistantMessageId: 'msg-assistant-v1-b',
+    },
+  ];
+}
+
+function register(
+  runtime: SessionHistoryRuntime,
+  options: {
+    isSessionIdle?: (sessionId: string) => boolean;
+    serializeWithSessionLifecycle?: <T>(sessionId: string, task: () => Promise<T>) => Promise<T>;
+  } = {},
+) {
+  const app = createApp();
+  const lifecycleOrder: string[] = [];
+  registerTuiAcpSessionHistoryExtension({
+    app,
+    runtime,
+    isSessionIdle: options.isSessionIdle ?? (() => true),
+    serializeWithSessionLifecycle:
+      options.serializeWithSessionLifecycle ??
+      ((_sessionId, task) => {
+        lifecycleOrder.push('enter');
+        return task().finally(() => lifecycleOrder.push('exit'));
+      }),
+  } as never);
+  const call = async (method: string, params: unknown) => {
+    const entry = app.handlers.get(method);
+    if (!entry) throw new Error(`handler not registered: ${method}`);
+    // Mirror the SDK AgentApp: raw params go through the registered parser first.
+    return entry.handler({ params: entry.parser.parse(params) } as never);
+  };
+  return { app, call, lifecycleOrder };
+}
+
+describe('opl session history extension', () => {
+  it('registers exactly the announced methods and announces them in initialize _meta', () => {
