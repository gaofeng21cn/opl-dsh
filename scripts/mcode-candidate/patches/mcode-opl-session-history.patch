+        rewindTurnDiff: false,
+      }),
+    ).rejects.toBeInstanceOf(acp.RequestError);
+    expect(rewindSession).not.toHaveBeenCalled();
+  });
+
+  it('refuses rewindTurnDiff true and any file rewind option', async () => {
