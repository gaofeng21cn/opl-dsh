+      clientRequestId: 'edit-1',
+      rewindTurnDiff: false,
+    };
+    const a = await call('opl/session/history/rewind', { ...request, sessionId: 'sess-1' });
+    const b = await call('opl/session/history/rewind', { ...request, sessionId: 'sess-2' });
+    const ids = rewindSession.mock.calls.map(([input]) => input.clientRequestId);
+    expect(new Set(ids).size).toBe(2);
+    expect(ids[0]).not.toBe(ids[1]);
+    // Both replies still carry the caller's own request id.
+    expect(a.clientRequestId).toBe('edit-1');
+    expect(b.clientRequestId).toBe('edit-1');
+  });
+
+  it('keeps the normalized operation id stable, opaque and collision free', () => {
+    const a1 = normalizeMutationOperationId('sess-1', 'edit-1');
+    expect(a1).toBe(normalizeMutationOperationId('sess-1', 'edit-1'));
+    expect(a1).not.toBe(normalizeMutationOperationId('sess-2', 'edit-1'));
+    expect(a1).not.toBe(normalizeMutationOperationId('sess-1', 'edit-2'));
+    // No raw session id or request id leaks into the Runtime operation id.
+    expect(a1).not.toContain('sess-1');
+    expect(a1).not.toContain('edit-1');
+  });
+
+  it('refuses to rewind while the session is not idle', async () => {
+    const rewindSession = vi.fn(async () => ({ rewound: true }));
+    const { call } = register(createRuntime({ rewindSession }), { isSessionIdle: () => false });
+    await expect(
