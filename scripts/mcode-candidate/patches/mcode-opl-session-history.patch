diff --git a/packages/tui/src/acp/session-history-extension.ts b/packages/tui/src/acp/session-history-extension.ts
new file mode 100644
index 0000000..b115498
--- /dev/null
+++ b/packages/tui/src/acp/session-history-extension.ts
@@ -0,0 +1,451 @@
+import { createHash } from 'node:crypto';
+
+import * as acp from '@agentclientprotocol/sdk';
+
+/**
+ * OPL session history extension v1.
+ *
+ * The capability is announced through `initialize` `_meta['opl/session-history']`.
+ * OPL keeps the feature closed unless this announcement is present, so registration
+ * and announcement must stay in lockstep: `oplSessionHistoryCapabilities()` is the
+ * single source used both by `registerTuiAcpSessionHistoryExtension` and by the
+ * initialize response.
+ */
+export const OPL_SESSION_HISTORY_META_KEY = 'opl/session-history';
+export const OPL_SESSION_HISTORY_VERSION = 1;
+
+export const OPL_SESSION_HISTORY_METHODS = {
+  list: 'opl/session/history/list',
+  rewind: 'opl/session/history/rewind',
+} as const;
+
+export const OPL_SESSION_HISTORY_NOTIFICATIONS = {
+  boundary: 'opl/session/history/boundary',
+} as const;
+
+/** `_meta['opl/clientRequestId']` on `session/prompt` carries the OPL operation identity. */
+export const OPL_CLIENT_REQUEST_ID_META_KEY = 'opl/clientRequestId';
+
+const MAX_ID_LENGTH = 512;
+
+/**
+ * Separator for in-memory composite keys only.
+ *
+ * It is never stored or sent to the Runtime: the operation id handed to the
+ * Runtime is a hash, and this separator only keeps `(sessionId, id)` keys
+ * unambiguous. Request ids that contain it are rejected outright.
+ */
+const KEY_SEPARATOR = '\u0000';
+
+/**
+ * Request keys that would ask for file or turn-diff rollback.
+ *
+ * The official Runtime rewind mutates conversation history only; `rewindTurnDiff`
+ * is the single documented switch that would also revert turn diffs. The other
+ * spellings are refused explicitly rather than ignored, so a client that asks
+ * for file rollback gets a refusal instead of a silent conversation-only rewind
+ * it would misread as a file restore.
+ */
+const FILE_ROLLBACK_KEYS = [
+  'rewindTurnDiff',
+  'rewindFiles',
+  'restoreFiles',
+  'files',
+  'scope',
+  'rewindTurnDiffs',
+] as const;
+
+export interface OplSessionHistoryCapabilities {
+  version: number;
+  methods: readonly string[];
+  notifications: readonly string[];
+}
+
+/** Announcement payload; also the parity reference for registration. */
+export function oplSessionHistoryCapabilities(): OplSessionHistoryCapabilities {
+  return {
+    version: OPL_SESSION_HISTORY_VERSION,
+    methods: [OPL_SESSION_HISTORY_METHODS.list, OPL_SESSION_HISTORY_METHODS.rewind],
+    notifications: [OPL_SESSION_HISTORY_NOTIFICATIONS.boundary],
+  };
+}
+
+export interface OplSessionHistoryListRequest {
+  sessionId: string;
+}
+
+export interface OplSessionHistoryEntry {
+  readonly userMessageId: string;
+  readonly contentHead?: string;
+  readonly timestamp: number;
+  readonly fileChangeCount: number;
+  readonly assistantMessageId?: string;
+}
+
+export interface OplSessionHistoryListResponse {
+  version: number;
+  sessionId: string;
+  entries: readonly OplSessionHistoryEntry[];
+}
+
+export interface OplSessionHistoryRewindRequest {
+  sessionId: string;
+  userMessageId: string;
+  /** OPL's operation identity for this edit; echoed back verbatim on the wire. */
+  clientRequestId: string;
+  /** Must be omitted or false; file rewind is intentionally unsupported. */
+  rewindTurnDiff?: boolean;
+}
+
+export interface OplSessionHistoryRewindResponse {
+  version: number;
+  rewound: true;
+  sessionId: string;
+  userMessageId: string;
+  /** The caller-supplied identity, never the normalized Runtime operation id. */
+  clientRequestId: string;
+  deletedMessageIds: readonly string[];
+  displayRevision?: string;
+  historyRevision?: string;
+}
+
+export interface OplSessionHistoryBoundaryNotification {
+  sessionId: string;
+  clientRequestId: string;
+  userMessageId: string;
+  turnId: string;
+}
+
+/**
+ * Structural view of the official TUI session port members this extension uses.
+ *
+ * These mirror `TuiSessionInputSummary`, `TuiRewindInput` and `TuiRewindResult`
+ * from `../runtime/port.js` field for field. Declaring them locally keeps the
+ * extension dependent only on the ACP SDK and node crypto; `TuiAcpRuntime` is
+ * still checked against them at the registration call site, so drift in the
+ * official port fails the package typecheck.
+ */
+export interface SessionHistoryInputSummary {
+  readonly userMessageId: string;
+  readonly assistantMessageId?: string;
+  readonly contentHead?: string;
+  readonly timestamp: number;
+  readonly fileChangeCount: number;
+}
+
+/** Minimal committed-message view used for the boundary binding. */
+export interface SessionHistoryCommittedMessage {
+  readonly id?: string;
+  readonly turnId?: string;
+  readonly role: 'user' | 'assistant' | 'system' | 'unknown';
+}
+
+/** Runtime surface consumed by the extension. */
+export interface SessionHistoryRuntime {
+  listSessionInputSummaries(
+    sessionId: string,
+    input?: { limit?: number; before?: string },
+  ): Promise<readonly SessionHistoryInputSummary[]>;
+  rewindSession(input: {
+    sessionId: string;
+    userMessageId: string;
+    clientRequestId: string;
+    rewindTurnDiff?: boolean;
+  }): Promise<{
+    rewound: boolean;
+    displayRevision?: string;
+    historyRevision?: string;
+    deletedMessageIds?: readonly string[];
+  }>;
+}
+
+export interface RegisterSessionHistoryExtensionOptions {
+  readonly app: acp.AgentApp;
+  readonly runtime: SessionHistoryRuntime;
+  /**
+   * True only when the ACP prompt lifecycle is not in flight for this session.
+   *
+   * This must reflect the whole prompt lifecycle, not just steerability: a
+   * session is not idle between prompt admission and the handler's `finally`,
+   * including a cancelled turn that has not settled yet and the questionnaire
+   * hand-off window.
+   */
+  readonly isSessionIdle: (sessionId: string) => boolean;
+  /**
+   * Runs `task` serialized with ACP prompt admission and recovery for the
+   * session, so a new prompt cannot slip in while a mutation awaits Runtime I/O.
+   */
+  readonly serializeWithSessionLifecycle: <T>(
+    sessionId: string,
+    task: () => Promise<T>,
+  ) => Promise<T>;
+}
+
+/** Extracts the OPL operation identity from `session/prompt` `_meta`. */
+export function readOplClientRequestId(meta: unknown): string | undefined {
+  if (!isRecord(meta)) return undefined;
+  const value = meta[OPL_CLIENT_REQUEST_ID_META_KEY];
+  if (typeof value !== 'string') return undefined;
+  const trimmed = value.trim();
+  if (!trimmed || trimmed.length > MAX_ID_LENGTH) return undefined;
+  return trimmed;
+}
+
+/**
+ * Derives the operation id handed to the official Runtime mutation ledger.
+ *
+ * The Runtime addresses its ledger by `operationId` plus `kind` only — see
+ * `clientRequestKey` in `operation-intent-repository.ts` — and rejects a reused
+ * id whose recorded session or target differs. OPL request ids are only unique
+ * per operation, so the same `initial` or `edit-1` in two sessions would collide
+ * and fail as a request conflict. Hashing the pair keeps every operation
+ * session-scoped without storing either raw id, and keeps the value free of
+ * delimiter ambiguity.
+ *
+ * The caller's original id is what travels back on the wire.
+ */
+export function normalizeMutationOperationId(sessionId: string, clientRequestId: string): string {
+  const digest = createHash('sha256')
+    .update(`${sessionId}${KEY_SEPARATOR}${clientRequestId}`, 'utf8')
+    .digest('hex')
+    .slice(0, 32);
+  return `oplsh1-${digest}`;
+}
+
+/**
+ * Binds one `(sessionId, clientRequestId)` to a real admitted boundary.
+ *
+ * The runtime streams the committed user message with its real `msg_id` and the
+ * turn id that admitted it, so this binding uses only those ids. It never falls
+ * back to content head, timestamps, or ordering, and it ignores any message whose
+ * role is not `user` so injected or automatic continuation turns cannot create a
+ * mapping. Keys combine session and request id with a separator that request ids
+ * cannot contain, so two sessions using the same request id stay independent.
+ */
+export class OplSessionBoundaryTracker {
+  private readonly pending = new Map<string, string>();
+  private readonly settled = new Map<string, OplSessionHistoryBoundaryNotification>();
+
+  /** Registers the operation identity admitted for `turnId`. */
+  track(sessionId: string, turnId: string, clientRequestId: string): void {
+    if (this.settled.has(boundaryKey(sessionId, clientRequestId))) return;
+    this.pending.set(pendingKey(sessionId, turnId), clientRequestId);
+  }
+
+  /** Returns the boundary the stream proves, or undefined when the event proves none. */
+  resolve(
+    sessionId: string,
+    message: SessionHistoryCommittedMessage,
+  ): OplSessionHistoryBoundaryNotification | undefined {
+    if (message.role !== 'user') return undefined;
+    const { turnId, id: userMessageId } = message;
+    if (!turnId || !userMessageId) return undefined;
+    const key = pendingKey(sessionId, turnId);
+    const clientRequestId = this.pending.get(key);
+    if (!clientRequestId) return undefined;
+    this.pending.delete(key);
+    const boundary: OplSessionHistoryBoundaryNotification = {
+      sessionId,
+      clientRequestId,
+      userMessageId,
+      turnId,
+    };
+    this.settled.set(boundaryKey(sessionId, clientRequestId), boundary);
+    return boundary;
+  }
+
+  /** True when this operation already reported a boundary; keeps replay idempotent. */
+  has(sessionId: string, clientRequestId: string): boolean {
+    return this.settled.has(boundaryKey(sessionId, clientRequestId));
+  }
+}
+
+/**
+ * Registers both requests with the same method strings that
+ * `oplSessionHistoryCapabilities()` announces, so the served surface and the
+ * `initialize` `_meta` cannot drift apart.
+ */
+export function registerTuiAcpSessionHistoryExtension(
+  options: RegisterSessionHistoryExtensionOptions,
+): void {
+  const { app, runtime } = options;
+  const capabilities = oplSessionHistoryCapabilities();
+
+  app.onRequest<OplSessionHistoryListRequest, OplSessionHistoryListResponse>(
+    capabilities.methods[0],
+    { parse: parseListRequest },
+    async ({ params }) =>
+      options.serializeWithSessionLifecycle(params.sessionId, async () => {
+        try {
+          const summaries = await runtime.listSessionInputSummaries(params.sessionId);
+          return {
+            version: OPL_SESSION_HISTORY_VERSION,
+            sessionId: params.sessionId,
+            entries: summaries.map(toEntry),
+          };
+        } catch {
+          // Never reflect Runtime diagnostics: they can carry paths, prompts or keys.
+          throw acp.RequestError.internalError(
+            undefined,
+            'opl/session/history/list could not read the session boundary list.',
+          );
+        }
+      }),
+  );
+
+  app.onRequest<OplSessionHistoryRewindRequest, OplSessionHistoryRewindResponse>(
+    capabilities.methods[1],
+    { parse: parseRewindRequest },
+    async ({ params }) =>
+      options.serializeWithSessionLifecycle(params.sessionId, async () => {
+        if (!options.isSessionIdle(params.sessionId)) {
+          throw acp.RequestError.invalidRequest(
+            undefined,
+            'session is still running a turn; wait until it becomes idle before rewinding.',
+          );
+        }
+        // No pre-flight preview here on purpose. The official Runtime checks the
+        // boundary itself, and its order is: validate the request, return the
+        // recorded result for a completed operation, and only then plan the
+        // mutation. A preview before the rewind would reject the retry of an
+        // already-applied rewind, because the first attempt deleted the very
+        // boundary the preview looks up.
+        let result;
+        try {
+          result = await runtime.rewindSession({
+            sessionId: params.sessionId,
+            userMessageId: params.userMessageId,
+            clientRequestId: normalizeMutationOperationId(
+              params.sessionId,
+              params.clientRequestId,
+            ),
+            rewindTurnDiff: false,
+          });
+        } catch (error) {
+          throw rewindFailure(error);
+        }
+        if (!result.rewound) {
+          throw acp.RequestError.internalError(
+            undefined,
+            'The Runtime did not confirm this history rewind. Read the session history before retrying.',
+          );
+        }
+        return {
+          version: OPL_SESSION_HISTORY_VERSION,
+          rewound: true,
+          sessionId: params.sessionId,
+          userMessageId: params.userMessageId,
+          clientRequestId: params.clientRequestId,
+          deletedMessageIds: result.deletedMessageIds ?? [],
+          ...(result.displayRevision ? { displayRevision: result.displayRevision } : {}),
+          ...(result.historyRevision ? { historyRevision: result.historyRevision } : {}),
+        };
+      }),
+  );
+}
+
+/**
+ * Public, fixed text for known Runtime refusals.
+ *
+ * Keys are Runtime error codes. Anything unrecognised collapses to a generic
+ * message, and no branch ever copies a Runtime-supplied message into the ACP
+ * response.
+ */
+const PUBLIC_REWIND_FAILURES: Readonly<Record<string, string>> = Object.freeze({
+  MESSAGE_BOUNDARY_INVALID:
+    'This user message is not a rewindable conversation boundary for this session.',
+  CONVERSATION_MUTATION_REQUEST_CONFLICT:
+    'This request identity was already used for a different conversation mutation.',
+  CONVERSATION_MUTATION_NOT_SUPPORTED:
+    'This session does not support conversation history rewind.',
+  HISTORY_CHAIN_CORRUPT:
+    'The previous conversation mutation did not complete; start a new request.',
+});
+
+function rewindFailure(error: unknown): acp.RequestError {
+  const code = readErrorCode(error);
+  const message = (code && PUBLIC_REWIND_FAILURES[code]) || undefined;
+  if (message) return acp.RequestError.invalidRequest(undefined, message);
+  return acp.RequestError.internalError(
+    undefined,
+    'The Runtime could not confirm this conversation history rewind. Read the session history before retrying.',
+  );
+}
+
+/** Reads only a short, allow-listed code off an error; never its message or stack. */
+function readErrorCode(error: unknown): string | undefined {
+  if (typeof error !== 'object' || error === null) return undefined;
+  const code = (error as { code?: unknown }).code;
+  return typeof code === 'string' && Object.hasOwn(PUBLIC_REWIND_FAILURES, code) ? code : undefined;
+}
+
+function toEntry(summary: SessionHistoryInputSummary): OplSessionHistoryEntry {
+  return {
+    userMessageId: summary.userMessageId,
+    timestamp: summary.timestamp,
+    fileChangeCount: summary.fileChangeCount,
+    ...(summary.contentHead ? { contentHead: summary.contentHead } : {}),
+    ...(summary.assistantMessageId ? { assistantMessageId: summary.assistantMessageId } : {}),
+  };
+}
+
+function parseListRequest(value: unknown): OplSessionHistoryListRequest {
+  return { sessionId: requireId(value, 'sessionId') };
+}
+
+function parseRewindRequest(value: unknown): OplSessionHistoryRewindRequest {
+  const record = requireRecord(value);
+  for (const key of FILE_ROLLBACK_KEYS) {
+    const requested = record[key];
+    if (requested === undefined || requested === null) continue;
+    const conversationOnly = requested === false || requested === 'conversation';
+    if (!conversationOnly) {
+      throw acp.RequestError.invalidRequest(
+        undefined,
+        `${key} must be omitted, false, or "conversation"; this extension rewinds conversation history only and never reverts files.`,
+      );
+    }
+  }
+  return {
+    sessionId: requireId(value, 'sessionId'),
+    userMessageId: requireId(value, 'userMessageId'),
+    clientRequestId: requireId(value, 'clientRequestId'),
+    ...(record.rewindTurnDiff === undefined ? {} : { rewindTurnDiff: false }),
+  };
+}
+
+function requireId(value: unknown, key: string): string {
+  const record = requireRecord(value);
+  const field = record[key];
+  if (typeof field !== 'string') {
+    throw acp.RequestError.invalidParams(undefined, `${key} must be a string.`);
+  }
+  const trimmed = field.trim();
+  if (!trimmed || trimmed.length > MAX_ID_LENGTH) {
+    throw acp.RequestError.invalidParams(undefined, `${key} must be a non-empty id.`);
+  }
+  // The separator is reserved so composite keys stay unambiguous.
+  if (trimmed.includes(KEY_SEPARATOR)) {
+    throw acp.RequestError.invalidParams(undefined, `${key} must not contain a NUL character.`);
+  }
+  return trimmed;
+}
+
+function requireRecord(value: unknown): Record<string, unknown> {
+  if (!isRecord(value)) {
+    throw acp.RequestError.invalidParams(undefined, 'Extension params must be an object.');
+  }
+  return value;
+}
+
+function isRecord(value: unknown): value is Record<string, unknown> {
+  return Boolean(value) && typeof value === 'object' && !Array.isArray(value);
+}
+
+function pendingKey(sessionId: string, turnId: string): string {
+  return `${sessionId}${KEY_SEPARATOR}${turnId}`;
+}
+
+function boundaryKey(sessionId: string, clientRequestId: string): string {
+  return `${sessionId}${KEY_SEPARATOR}${clientRequestId}`;
+}
