+const NOTIFY_CAPABILITIES = {
+  _meta: { 'minimax-code/extensions': { version: 1, notifications: true } },
+};
+
+async function withAgent(
+  runtime: TuiAcpRuntime,
+  body: (connection: acp.AgentConnection, ctx: { sessionId: string; boundaries: unknown[] }) => Promise<void>,
+  options: { notify?: boolean; turnIds?: string[] } = {},
+): Promise<{ boundaries: unknown[] }> {
+  const boundaries: unknown[] = [];
+  const client = options.notify
+    ? acp
+        .client({ name: 'opl' })
+        .onNotification('opl/session/history/boundary', PASSTHROUGH, ({ params }) =>
+          boundaries.push(params),
+        )
+    : acp.client({ name: 'opl' });
+  const turnIds = [...(options.turnIds ?? [])];
+  const agent = createTuiAcpAgent({
+    runtime,
+    version: '1.2.3',
+    createTurnId: () => turnIds.shift() ?? 'turn-extra',
+  });
+  await client.connectWith(agent, async (connection) => {
+    await connection.request(acp.methods.agent.initialize, {
+      protocolVersion: acp.PROTOCOL_VERSION,
+      clientCapabilities: options.notify ? NOTIFY_CAPABILITIES : {},
+    });
+    const session = await connection.request(acp.methods.agent.session.new, {
+      cwd: '/workspace',
+      mcpServers: [],
+    });
+    await body(connection, { sessionId: session.sessionId, boundaries });
+  });
+  return { boundaries };
