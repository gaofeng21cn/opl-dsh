+import { afterEach, describe, expect, it, vi } from 'vitest';
+import { existsSync } from 'node:fs';
+import { tmpdir } from 'node:os';
+import { getShellConfig } from '@earendil-works/pi-coding-agent/shell';
+import { createLocalBashOperations } from '@earendil-works/pi-coding-agent/tools';
+
+afterEach(() => vi.unstubAllEnvs());
+const bash = process.platform === 'win32' ? 'C:/Program Files/Git/bin/bash.exe' : '/bin/bash';
+
+describe('explicit process shell selection', () => {
+  it('rejects a missing or relative environment override without choosing the platform default', () => {
+    for (const invalid of ['bash', '', 'C:/not-installed/bash.exe']) {
+      vi.stubEnv('MCODE_SHELL_PATH', invalid);
+      expect(() => getShellConfig()).toThrow(/MCODE_SHELL_PATH/);
+    }
+  });
+
+  it.skipIf(!existsSync(bash))('uses the same selected Bash for reporting and real operations', async () => {
+    vi.stubEnv('MCODE_SHELL_PATH', bash);
+    expect(getShellConfig()).toEqual({ shell: bash, args: ['-c'], type: 'bash' });
+    const chunks: Buffer[] = [];
+    const result = await createLocalBashOperations().exec('printf "BASH_SELECTED:%s" "$BASH_VERSION"; exit 17', tmpdir(), {
+      onData: data => chunks.push(data), timeout: 10,
+    });
+    expect(Buffer.concat(chunks).toString()).toMatch(/BASH_SELECTED:[0-9]/);
+    expect(result.exitCode).toBe(17);
+  });
+});
+
+describe.skipIf(process.platform !== 'win32' || !existsSync(bash))('Git Bash process lifecycle', () => {
+  it('ends the owned descendant after cancellation', async () => {
+    vi.stubEnv('MCODE_SHELL_PATH', bash);
+    const controller = new AbortController();
+    let pid: number | undefined;
+    let output = '';
+    const command = `node -e 'console.log("CHILD_PID="+process.pid);setInterval(()=>{},1000)'`;
+    const running = createLocalBashOperations({ parentDeathGuard: true }).exec(command, tmpdir(), {
+      signal: controller.signal, timeout: 15,
+      onData: data => {
+        output += data.toString();
+        const found = output.match(/CHILD_PID=(\d+)/);
+        if (found) { pid = Number(found[1]); controller.abort(); }
+      },
+    });
+    await expect(running).rejects.toThrow(/aborted/);
+    expect(pid).toBeGreaterThan(0);
+    await expect.poll(() => { try { process.kill(pid!, 0); return true; } catch { return false; } }, { timeout: 5000, interval: 20 }).toBe(false);
+  }, 20000);
+
+  it('reports command timeout and streams stdout and stderr', async () => {
+    vi.stubEnv('MCODE_SHELL_PATH', bash);
+    const chunks: Buffer[] = [];
+    const ops = createLocalBashOperations();
+    await expect(ops.exec('printf "TIMEOUT_STDOUT"; printf "TIMEOUT_STDERR" >&2; sleep 30', tmpdir(), {
+      timeout: 0.25, onData: data => chunks.push(data),
+    })).rejects.toThrow(/timeout/);
+    const output = Buffer.concat(chunks).toString();
+    expect(output).toContain('TIMEOUT_STDOUT');
+    expect(output).toContain('TIMEOUT_STDERR');
+  }, 15000);
+});
