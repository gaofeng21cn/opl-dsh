+#[test]
+fn test_bash_admission_allows_unix_bash_under_restricted_policy() {
+    // A POSIX/local Bash that is not Git for Windows must never be refused, so
+    // Linux and WSL sessions keep their existing behaviour.
+    let unix_bash = Shell {
+        shell_type: ShellType::Bash,
+        shell_path: std::path::PathBuf::from("/bin/bash"),
+    };
+    assert_eq!(
+        BashAdmission::evaluate(
+            &unix_bash,
+            /*is_remote*/ false,
+            CommandShellPolicy::Restricted
+        ),
+        BashAdmission::NotRefused
+    );
+}
