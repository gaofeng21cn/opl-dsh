+#[test]
+fn test_bash_admission_allows_remote_bash_under_restricted_policy() {
+    // A remote environment keeps its own semantics even on a Windows host.
+    let git_bash = Shell {
+        shell_type: ShellType::Bash,
+        shell_path: std::path::PathBuf::from(r"C:\Program Files\Git\bin\bash.exe"),
+    };
+    assert_eq!(
+        BashAdmission::evaluate(
+            &git_bash,
+            /*is_remote*/ true,
+            CommandShellPolicy::Restricted
+        ),
+        BashAdmission::NotRefused
+    );
+}
