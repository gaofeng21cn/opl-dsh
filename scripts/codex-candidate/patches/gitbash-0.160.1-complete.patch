+#[cfg(windows)]
+#[test]
+fn test_bash_admission_refuses_local_git_for_windows_bash_when_restricted() {
+    let git_bash = Shell {
+        shell_type: ShellType::Bash,
+        shell_path: std::path::PathBuf::from(r"C:\Program Files\Git\bin\bash.exe"),
+    };
+    assert_eq!(
+        BashAdmission::evaluate(
+            &git_bash,
+            /*is_remote*/ false,
+            CommandShellPolicy::Restricted
+        ),
+        BashAdmission::RefusedGitBash
+    );
+    // Full access is the documented supported mode for Git Bash.
+    assert_eq!(
+        BashAdmission::evaluate(
+            &git_bash,
+            /*is_remote*/ false,
+            CommandShellPolicy::FullAccess
+        ),
+        BashAdmission::NotRefused
+    );
+}
