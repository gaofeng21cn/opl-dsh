+#[test]
+fn rejects_wsl_launcher_paths() {
+    for path in [
+        r"C:\Windows\System32\bash.exe",
+        r"\\wsl$\Ubuntu\bin\bash.exe",
+        r"\\wsl.localhost\Ubuntu\bin\bash.exe",
