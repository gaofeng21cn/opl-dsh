+//! Opt-in selection of Git for Windows Bash as the Windows default shell.
+//!
+//! Codex's built-in Windows default is PowerShell: `shell_detect`'s
+//! `default_user_shell_from_path` ignores `$SHELL` and the passwd shell on
+//! Windows. A user who wants the model's `exec_command` to run in Git for
+//! Windows Bash opts in explicitly via `CODEX_NATIVE_GIT_BASH_PATH`.
+//!
+//! Design rules for this module:
+//!
+//! * Explicit opt-in only. No configuration means PowerShell, exactly as before.
+//! * Fail closed. A configured path that is not clearly Git for Windows Bash is
+//!   rejected with an error. We never guess, never fall back to PowerShell, and
+//!   never accept the WSL launcher, a WSL UNC path, or an MSYS-style path.
+//! * Layout and identity checks happen once per session start;
+//!   command execution reuses the validated canonical
+//!   path and never re-probes.
+//! * This is a sanity check against mixing up executables (a renamed `cmd.exe`,
+//!   a text file, the WSL launcher). It is **not** authentication of a hostile
+//!   binary.
+
+use std::path::Path;
+use std::path::PathBuf;
+use std::process::Stdio;
+use std::time::Duration;
+
+/// Candidate-only process setting. This is not an upstream TOML configuration key.
+/// Remote executors keep the shell reported by their own environment.
+pub(crate) async fn configured_shell(
+    base_profile: &codex_protocol::models::PermissionProfile,
+) -> anyhow::Result<Option<crate::shell::Shell>> {
+    if !cfg!(windows) {
+        return Ok(None);
+    }
+    let Some(path) = std::env::var_os("CODEX_NATIVE_GIT_BASH_PATH") else {
+        return Ok(None);
+    };
+    ensure_full_access_for_git_bash(matches!(
+        base_profile,
+        codex_protocol::models::PermissionProfile::Disabled
+    ))
+    .map_err(anyhow::Error::msg)?;
+    let shell_path = resolve_configured_git_bash(Path::new(&path)).map_err(anyhow::Error::msg)?;
+    verify_git_bash_identity(&shell_path)
+        .await
+        .map_err(anyhow::Error::msg)?;
+    Ok(Some(crate::shell::Shell {
+        shell_type: crate::shell::ShellType::Bash,
+        shell_path,
+    }))
+}
+
+/// Upper bound for the one-time Bash identity probe.
+const IDENTITY_PROBE_TIMEOUT: Duration = Duration::from_secs(10);
+/// Upper bound for captured probe output.
+const IDENTITY_PROBE_MAX_OUTPUT_BYTES: usize = 8 * 1024;
+
+/// Why a configured `git_bash_path` cannot be used.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub(crate) enum GitBashPathError {
+    /// The path is not absolute, or uses an MSYS-style `/c/...` root.
+    NotAnAbsoluteWindowsPath(String),
+    /// The path points at the WSL launcher (`System32\bash.exe`), `wsl.exe`, or
+    /// a `\\wsl$\...` UNC path.
+    WslLauncher(String),
+    /// The executable name is not exactly `bash`/`bash.exe`.
+    NotBash(String),
+    /// The path does not look like a Git for Windows installation.
+    NotGitForWindows(String),
+    /// The file does not exist or is not a regular file.
+    Missing(String),
+    /// A Git for Windows install root was found but a required layout marker is
+    /// absent, so the installation looks incomplete.
+    IncompleteInstall(String),
+}
+
+impl GitBashPathError {
+    pub(crate) fn message(&self) -> String {
+        match self {
+            Self::NotAnAbsoluteWindowsPath(path) => format!(
+                "`CODEX_NATIVE_GIT_BASH_PATH` must be an absolute Windows path such as \
+                 `C:\\Program Files\\Git\\bin\\bash.exe`; got `{path}`. MSYS-style paths like \
+                 `/c/...` and `/mnt/c/...` are ambiguous and are not accepted."
+            ),
+            Self::WslLauncher(path) => format!(
+                "`CODEX_NATIVE_GIT_BASH_PATH` points at a WSL entry point (`{path}`). Codex requires \
+                 Git for Windows Bash here; use `C:\\Program Files\\Git\\bin\\bash.exe`."
+            ),
+            Self::NotBash(path) => format!(
+                "`CODEX_NATIVE_GIT_BASH_PATH` must point at a Bash executable named `bash.exe`; got \
+                 `{path}`."
+            ),
+            Self::NotGitForWindows(path) => format!(
+                "`CODEX_NATIVE_GIT_BASH_PATH` must point at a Git for Windows Bash installation (for \
+                 example `C:\\Program Files\\Git\\bin\\bash.exe`); got `{path}`. To use Bash under \
+                 WSL, run Codex inside that WSL distribution instead."
+            ),
+            Self::Missing(path) => {
+                format!("`CODEX_NATIVE_GIT_BASH_PATH` file does not exist: `{path}`.")
+            }
+            Self::IncompleteInstall(path) => format!(
+                "`CODEX_NATIVE_GIT_BASH_PATH` points into a Git for Windows installation without its \
+                 `cmd\\git.exe` layout marker (`{path}`); the installation \
+                 looks incomplete."
+            ),
+        }
+    }
+}
+
+impl std::fmt::Display for GitBashPathError {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.write_str(&self.message())
+    }
+}
+
+/// A Git for Windows Bash that passed layout checks.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub(crate) struct GitBashShell {
+    /// Canonical absolute path to the Bash executable.
+    pub(crate) path: PathBuf,
+    /// Git for Windows installation root, for example `C:\Program Files\Git`.
+    pub(crate) install_root: PathBuf,
+}
+
+/// True when the path is expressed as a native Windows absolute path.
+///
+/// Rejects MSYS-style `/c/...`, `/mnt/c/...`, and `\\wsl$\...` paths, which are
+/// not meaningful to a native Windows process.
+fn is_native_windows_absolute(path: &Path) -> bool {
+    let Some(text) = path.to_str() else {
+        return false;
+    };
+    let bytes = text.as_bytes();
+    let has_drive_prefix = bytes.len() >= 3
+        && bytes[0].is_ascii_alphabetic()
+        && bytes[1] == b':'
+        && (bytes[2] == b'\\' || bytes[2] == b'/');
+    // `\\?\C:\...` and `\\server\share` are native; `\\wsl$\...` is not.
+    let has_unc_prefix = text.starts_with("\\\\") && !is_wsl_unc(path);
+    has_drive_prefix || has_unc_prefix
+}
+
+/// True for `\\wsl$\<distro>\...` and `\\wsl.localhost\...` UNC paths.
+fn is_wsl_unc(path: &Path) -> bool {
+    let lowered = path.to_string_lossy().to_ascii_lowercase();
+    lowered.starts_with("\\\\wsl$\\")
+        || lowered.starts_with("\\\\wsl.localhost\\")
+        || lowered.starts_with("//wsl$/")
+        || lowered.starts_with("//wsl.localhost/")
+}
+
+/// True when the path targets the WSL Bash entry point rather than Git Bash.
+fn targets_wsl_launcher(path: &Path) -> bool {
+    if is_wsl_unc(path) {
+        return true;
+    }
+    let normalised = path
+        .to_string_lossy()
+        .to_ascii_lowercase()
+        .replace('/', "\\");
+    normalised.contains("\\windows\\system32\\bash.exe")
+        || normalised.ends_with("\\wsl.exe")
+        || normalised.contains("\\windowsapps\\") && normalised.ends_with("bash.exe")
+}
+
+/// True when the executable file name is exactly Bash (case-insensitive).
+///
+/// Requires an `.exe` extension (or no extension for MSYS-style callers); a
+/// `bash.cmd` or `bash.txt` file is rejected.
+fn is_bash_file_name(path: &Path) -> bool {
+    let Some(extension) = path.extension() else {
+        // Bare `bash` with no extension is accepted for callers that pass the
+        // MSYS-style name; it still has to pass the layout checks below.
+        return path
+            .file_name()
+            .and_then(|name| name.to_str())
+            .is_some_and(|name| name.eq_ignore_ascii_case("bash"));
+    };
+    if !extension.eq_ignore_ascii_case("exe") {
+        return false;
+    }
+    path.file_stem()
+        .and_then(|stem| stem.to_str())
+        .is_some_and(|stem| stem.eq_ignore_ascii_case("bash"))
+}
+
+/// Split a path into lowercase components.
+fn components_lowercase(path: &Path) -> Vec<String> {
+    path.components()
+        .filter_map(|component| component.as_os_str().to_str())
+        .map(str::to_ascii_lowercase)
+        .collect()
+}
+
+/// Derive the Git for Windows installation root from a `...\bin\bash.exe` or
+/// `...\usr\bin\bash.exe` path.
+///
+/// Returns `(install_root, under_usr_bin)`. The root directory name is **not**
+/// restricted: custom installation roots are accepted, and the real layout
+/// marker check happens in [`resolve_configured_git_bash`].
+fn split_git_install_root(path: &Path) -> Option<(PathBuf, bool)> {
+    let components = components_lowercase(path);
+    let (bin_depth, under_usr_bin) = if components.len() >= 3
+        && components[components.len() - 3] == "usr"
+        && components[components.len() - 2] == "bin"
+    {
+        (3usize, true)
+    } else if components.len() >= 2 && components[components.len() - 2] == "bin" {
+        (2usize, false)
+    } else {
+        return None;
+    };
+    let keep = components.len() - bin_depth;
+    if keep == 0 {
+        return None;
+    }
+    let mut root = PathBuf::new();
+    for component in path.components().take(keep) {
+        root.push(component);
+    }
+    Some((root, under_usr_bin))
+}
+
+/// Classify a configured path as Git for Windows Bash without touching disk.
+pub(crate) fn classify_git_bash_path(path: &Path) -> Result<GitBashShell, GitBashPathError> {
+    if targets_wsl_launcher(path) {
+        return Err(GitBashPathError::WslLauncher(path.display().to_string()));
+    }
+    if !is_native_windows_absolute(path) {
+        return Err(GitBashPathError::NotAnAbsoluteWindowsPath(
+            path.display().to_string(),
+        ));
+    }
+    if !is_bash_file_name(path) {
+        return Err(GitBashPathError::NotBash(path.display().to_string()));
+    }
+    let Some((install_root, _under_usr_bin)) = split_git_install_root(path) else {
+        return Err(GitBashPathError::NotGitForWindows(
+            path.display().to_string(),
+        ));
+    };
+    Ok(GitBashShell {
+        path: path.to_path_buf(),
+        install_root,
+    })
+}
+
+/// True when `dir` contains the Git for Windows layout marker.
+///
+/// The marker is the real Git executable, not a directory name: a custom
+/// installation root is fine as long as it is a Git for Windows layout.
+fn has_git_layout_marker(root: &Path) -> bool {
+    root.join("cmd").join("git.exe").is_file()
+}
+
+/// Validate a configured `CODEX_NATIVE_GIT_BASH_PATH` end to end.
+///
+/// Canonicalizes the path (so NTFS junctions and symlinks resolve to their real
+/// target before identity decisions), re-checks identity on the canonical path,
+/// and verifies the Git for Windows layout marker. Called once during session
+/// startup; the returned canonical path is reused for the whole session.
+pub(crate) fn resolve_configured_git_bash(path: &Path) -> Result<PathBuf, String> {
+    classify_git_bash_path(path).map_err(|err| err.message())?;
+    let canonical = std::fs::canonicalize(path)
+        .map_err(|_| GitBashPathError::Missing(path.display().to_string()).message())?;
+    let shell = classify_git_bash_path(&canonical).map_err(|err| err.message())?;
+    if !shell.path.is_file() {
+        return Err(GitBashPathError::Missing(shell.path.display().to_string()).message());
+    }
+    if !has_git_layout_marker(&shell.install_root) {
+        return Err(
+            GitBashPathError::IncompleteInstall(shell.install_root.display().to_string()).message(),
+        );
+    }
+    Ok(shell.path)
+}
+
+/// Reject an opt-in Git Bash shell when the session's **base** permission profile
+/// does not disable the sandbox.
+///
+/// Called before the identity probe spawns, so a restricted configuration never
+/// executes the configured shell's startup path at all. `base_profile_disables_sandbox`
+/// must be derived from the environment's base `PermissionProfile` (only
+/// `PermissionProfile::Disabled` is `true`). Per-turn and per-call additional
+/// permissions are never treated as an escalation into full access.
+pub(crate) fn ensure_full_access_for_git_bash(
+    base_profile_disables_sandbox: bool,
+) -> Result<(), String> {
+    if base_profile_disables_sandbox {
+        return Ok(());
+    }
+    Err(
+        "`CODEX_NATIVE_GIT_BASH_PATH` is set but this session's base permission profile is \
+         restricted. Git for Windows Bash has no sandbox backend on Windows, so Codex refuses \
+         to run it under a restricted profile rather than running it unsandboxed. Disable the \
+         sandbox (`--dangerously-bypass-approvals-and-sandbox` or `sandbox_mode = \
+         \"danger-full-access\"`) or unset `CODEX_NATIVE_GIT_BASH_PATH`."
+            .to_string(),
+    )
+}
+
+/// Model guidance follows the selected local shell without changing tool parameters.
+pub(crate) const GIT_BASH_GUIDANCE: &str = "\n\nCommands use Git for Windows Bash. Use POSIX shell syntax. The login option retains its documented behavior. Working directories may use `/c/...` or native Windows absolute paths; `/mnt/...` and other POSIX mount roots are unsupported. Keep destructive file operations in one shell and verify resolved targets before deleting or moving files.";
+
+/// Resolve an explicit request against the already-validated configured shell.
+pub(crate) fn validate_shell_request(requested: &str, configured: &Path) -> Result<(), String> {
+    if requested.eq_ignore_ascii_case("bash") || requested.eq_ignore_ascii_case("bash.exe") {
+        return Ok(());
+    }
+    let path = Path::new(requested);
+    if !path.is_absolute() || !is_bash_file_name(path) {
+        return Err(format!(
+            "shell `{requested}` must be bare bash/bash.exe or the configured absolute Git Bash path"
+        ));
+    }
+    let canonical = std::fs::canonicalize(path)
+        .map_err(|err| format!("cannot resolve requested shell `{requested}`: {err}"))?;
+    if canonical != configured {
+        return Err(format!(
+            "shell `{requested}` does not match CODEX_NATIVE_GIT_BASH_PATH; omit shell to use the configured executable"
+        ));
+    }
+    Ok(())
+}
+
+/// Drain while retaining a fixed-size prefix. Dropping this future closes the
+/// pipe, including when another process still holds an inherited writer.
+async fn drain_capped(mut reader: impl tokio::io::AsyncRead + Unpin) -> std::io::Result<Vec<u8>> {
+    use tokio::io::AsyncReadExt;
+    let mut kept = Vec::with_capacity(IDENTITY_PROBE_MAX_OUTPUT_BYTES);
+    let mut buffer = [0u8; 4096];
+    loop {
+        let read = reader.read(&mut buffer).await?;
+        if read == 0 {
+            return Ok(kept);
+        }
+        let remaining = IDENTITY_PROBE_MAX_OUTPUT_BYTES - kept.len();
+        kept.extend_from_slice(&buffer[..read.min(remaining)]);
+    }
+}
+
+/// Cancels the pipe reader if the probe future is cancelled or times out.
+struct ProbeReader(tokio::task::JoinHandle<std::io::Result<Vec<u8>>>);
+
+impl Drop for ProbeReader {
+    fn drop(&mut self) {
+        self.0.abort();
+    }
+}
+
+/// Probe one executable with a single deadline covering both exit and pipe EOF.
+/// Only the direct child is owned here; no descendant-cleanup guarantee is made.
+async fn probe_identity(
+    command: &mut tokio::process::Command,
+    timeout: Duration,
+) -> Result<(), String> {
+    command
+        .stdin(Stdio::null())
+        .stdout(Stdio::piped())
+        .stderr(Stdio::null())
+        .env_remove("BASH_ENV")
+        .env_remove("ENV")
+        .kill_on_drop(true);
+    #[cfg(windows)]
+    command.creation_flags(0x0800_0000); // CREATE_NO_WINDOW
+    let mut child = command
+        .spawn()
+        .map_err(|err| format!("identity probe spawn failed: {err}"))?;
+    let stdout = child
+        .stdout
+        .take()
+        .ok_or_else(|| "identity probe stdout unavailable".to_string())?;
+    let mut reader = ProbeReader(tokio::spawn(drain_capped(stdout)));
+    let result = tokio::time::timeout(timeout, async {
+        let status = child.wait().await?;
+        let output = (&mut reader.0).await.map_err(std::io::Error::other)??;
+        Ok::<_, std::io::Error>((status, output))
+    })
+    .await;
+    let (status, output) = match result {
+        Ok(Ok(result)) => result,
+        other => {
+            let _ = child.start_kill();
+            let _ = tokio::time::timeout(Duration::from_secs(1), child.wait()).await;
+            return Err(match other {
+                Err(_) => "identity probe timed out (process or inherited stdout remained open)"
+                    .to_string(),
+                _ => "identity probe failed while reading output or waiting for exit".to_string(),
+            });
+        }
+    };
+    if !status.success() {
+        return Err(format!("identity probe exited with {status}"));
+    }
+    if !String::from_utf8_lossy(&output)
+        .lines()
+        .any(|line| line.starts_with("GNU bash, version "))
+    {
+        return Err("identity probe did not report a GNU Bash version".to_string());
+    }
+    Ok(())
+}
+
+/// Run once after full-access admission, without Bash startup files or reliance
+/// on inherited MSYSTEM. This checks accidental executable mismatches, not trust.
+pub(crate) async fn verify_git_bash_identity(canonical_bash: &Path) -> Result<(), String> {
+    let mut command = tokio::process::Command::new(canonical_bash);
+    command.arg("--version");
+    probe_identity(&mut command, IDENTITY_PROBE_TIMEOUT)
+        .await
+        .map_err(|err| {
+            format!(
+                "CODEX_NATIVE_GIT_BASH_PATH `{}`: {err}",
+                canonical_bash.display()
+            )
+        })
+}
