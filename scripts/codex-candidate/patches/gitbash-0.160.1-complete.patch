+#[cfg(windows)]
+#[test]
+fn configured_git_bash_preserves_bare_names_and_rejects_mismatched_path() -> anyhow::Result<()> {
+    let path = std::path::Path::new(r"C:\Program Files\Git\bin\bash.exe");
+    if !path.is_file() {
+        return Ok(());
+    }
+    let canonical = std::fs::canonicalize(path)?;
+    let shell = Arc::new(Shell {
+        shell_type: ShellType::Bash,
+        shell_path: canonical.clone(),
+    });
+    for requested in ["bash", "BASH.EXE"] {
+        let args: ExecCommandArgs = parse_arguments(
+            &serde_json::json!({
+                "cmd": "echo ok", "shell": requested, "login": false
+            })
+            .to_string(),
+        )?;
+        let resolved = get_command(
+            &args,
+            Arc::clone(&shell),
+            &UnifiedExecShellMode::Direct,
+            /*allow_login_shell*/ true,
+            /*is_remote_environment*/ false,
+            CommandShellPolicy::FullAccess,
+        )
+        .map_err(anyhow::Error::msg)?;
+        assert_eq!(
+            resolved.command,
+            vec![
+                canonical.to_string_lossy().into_owned(),
+                "-c".to_string(),
+                "echo ok".to_string()
+            ]
+        );
+    }
+    for requested in ["bash.cmd", r"C:\not-the-selected-install\bin\bash.exe"] {
+        let args: ExecCommandArgs = parse_arguments(
+            &serde_json::json!({
+                "cmd": "echo ok", "shell": requested
+            })
+            .to_string(),
+        )?;
+        assert!(
+            get_command(
+                &args,
+                Arc::clone(&shell),
+                &UnifiedExecShellMode::Direct,
+                /*allow_login_shell*/ true,
+                /*is_remote_environment*/ false,
+                CommandShellPolicy::FullAccess,
+            )
+            .is_err()
+        );
+    }
+    Ok(())
+}
