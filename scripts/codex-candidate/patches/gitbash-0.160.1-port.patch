+/// A Git for Windows Bash session is refused under a restricted base profile,
+/// both for the session default shell and for an explicit bare `bash` request.
+#[cfg(windows)]
+#[test]
+fn test_get_command_refuses_git_for_windows_bash_under_restricted_policy() -> anyhow::Result<()> {
+    let git_bash = Shell {
+        shell_type: ShellType::Bash,
+        shell_path: std::path::PathBuf::from(r"C:\Program Files\Git\bin\bash.exe"),
+    };
+
+    for json in [
+        r#"{"cmd": "echo hello"}"#,
+        r#"{"cmd": "echo hello", "shell": "bash"}"#,
+    ] {
+        let args: ExecCommandArgs = parse_arguments(json)?;
+        let err = get_command(
+            &args,
+            Arc::new(git_bash.clone()),
+            &UnifiedExecShellMode::Direct,
+            /*allow_login_shell*/ true,
+            /*is_remote_environment*/ false,
+            CommandShellPolicy::Restricted,
+        )
+        .expect_err("Git for Windows Bash must be refused when the base profile is restricted");
+        assert!(err.contains("restricted"), "{err}");
+    }
+    Ok(())
+}
