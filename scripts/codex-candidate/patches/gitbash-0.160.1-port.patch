+    assert_eq!(
+        convert_msys_drive_workdir("/d/工作 目录"),
+        Some("D:\\工作 目录".to_string())
+    );
+    assert_eq!(convert_msys_drive_workdir("/c"), Some(r"C:\".to_string()));
+    // Already-native paths, unknown POSIX roots, and empty values are left alone so
+    // PowerShell and non-opt-in sessions keep the exact upstream behaviour.
+    for untouched in [r"C:\Users\me", "/usr/local/bin", "", "/", "/mnt/c/Users/me"] {
+        assert_eq!(
+            convert_msys_drive_workdir(untouched),
+            None,
+            "{untouched} must not be rewritten"
+        );
+    }
+}
