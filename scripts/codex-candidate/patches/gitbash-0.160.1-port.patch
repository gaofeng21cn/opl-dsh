+/// Reproduce the reviewer's clean-environment probe with this implementation.
+///
+/// Both `Git\bin\bash.exe` and `Git\usr\bin\bash.exe` are genuine Git for Windows
+/// Bash entry points. In a clean Desktop environment `usr\bin\bash.exe` reports an
+/// empty `MSYSTEM`, which is why identity must not depend on that variable.
+#[cfg(windows)]
+#[test]
+fn identity_probe_accepts_real_git_for_windows_bash_variants() {
+    let mut checked = 0;
+    for candidate in [
+        r"C:\Program Files\Git\bin\bash.exe",
+        r"C:\Program Files\Git\usr\bin\bash.exe",
+    ] {
+        let path = std::path::Path::new(candidate);
+        if !path.is_file() {
+            continue;
+        }
+        checked += 1;
+        tokio::runtime::Builder::new_current_thread()
+            .enable_all()
+            .build()
+            .unwrap()
+            .block_on(verify_git_bash_identity(path))
+            .unwrap_or_else(|err| panic!("{candidate} is a real Git Bash and must pass: {err}"));
+        // The identity probe must not install or depend on MSYSTEM.
+        assert!(
+            !candidate.contains("msystem"),
+            "identity must not key off MSYSTEM"
+        );
+    }
+    if checked == 0 {
+        eprintln!("skipping: no Git for Windows installation on this machine");
+    }
+}
