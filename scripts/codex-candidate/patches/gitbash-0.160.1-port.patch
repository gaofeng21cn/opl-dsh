+use super::*;
+
+// `classify_git_bash_path` and `resolve_configured_git_bash` reason about native
+// Windows paths, so the Windows-path cases are compiled and asserted only on
+// Windows. The platform-neutral cases below run everywhere.
+
+#[cfg(windows)]
+#[test]
+fn accepts_git_for_windows_bash_under_spaced_and_cjk_roots() {
+    for (path, expected_root) in [
+        (
+            r"C:\Program Files\Git\bin\bash.exe",
+            r"C:\Program Files\Git",
+        ),
+        (
+            r"C:\Program Files\Git\usr\bin\bash.exe",
+            r"C:\Program Files\Git",
+        ),
+        (
+            r"C:\Program Files\Git\bin\BASH.EXE",
+            r"C:\Program Files\Git",
+        ),
+        (
+            r"C:\Users\dev\AppData\Local\Programs\Git\bin\bash.exe",
+            r"C:\Users\dev\AppData\Local\Programs\Git",
+        ),
+        (r"D:\工具 安装\Git\bin\bash.exe", r"D:\工具 安装\Git"),
+    ] {
+        let classified = classify_git_bash_path(std::path::Path::new(path))
+            .unwrap_or_else(|err| panic!("{path} should be accepted, got {err}"));
+        assert_eq!(classified.path, std::path::Path::new(path), "{path}");
+        assert_eq!(
+            classified.install_root,
+            std::path::Path::new(expected_root),
+            "install root for {path}"
+        );
+    }
+}
+
+/// The layout marker is the real `cmd\git.exe` file, not the directory name: a
+/// custom installation root is accepted once it has that layout, and rejected
+/// without it. Exercises the real resolver against a real filesystem tree.
+#[cfg(windows)]
+#[test]
+fn resolve_requires_the_real_git_layout_marker_in_custom_roots() {
+    let base = std::env::temp_dir().join(format!("codex-git-bash-layout-{}", std::process::id()));
+    let _ = std::fs::remove_dir_all(&base);
+
+    let complete = base.join("complete-root");
+    std::fs::create_dir_all(complete.join("cmd")).unwrap();
+    std::fs::create_dir_all(complete.join("bin")).unwrap();
+    std::fs::write(complete.join("cmd").join("git.exe"), b"").unwrap();
+    std::fs::write(complete.join("bin").join("bash.exe"), b"").unwrap();
+    let resolved = resolve_configured_git_bash(&complete.join("bin").join("bash.exe"))
+        .expect("a custom root with cmd\\git.exe is a valid Git layout");
+    assert_eq!(
+        resolved,
+        std::fs::canonicalize(complete.join("bin").join("bash.exe")).unwrap()
+    );
+
+    let incomplete = base.join("incomplete-root");
+    std::fs::create_dir_all(incomplete.join("bin")).unwrap();
+    std::fs::write(incomplete.join("bin").join("bash.exe"), b"").unwrap();
+    let err = resolve_configured_git_bash(&incomplete.join("bin").join("bash.exe"))
+        .expect_err("a bash.exe without cmd\\git.exe must not be accepted");
+    assert!(err.contains("cmd\\git.exe"), "{err}");
+
+    let _ = std::fs::remove_dir_all(&base);
+}
+
+#[test]
+fn rejects_wsl_launcher_paths() {
+    for path in [
+        r"C:\Windows\System32\bash.exe",
+        r"\\wsl$\Ubuntu\bin\bash.exe",
+        r"\\wsl.localhost\Ubuntu\bin\bash.exe",
+    ] {
+        let err = classify_git_bash_path(std::path::Path::new(path))
+            .expect_err("WSL launcher must be rejected");
+        assert!(
+            matches!(err, GitBashPathError::WslLauncher(_)),
+            "unexpected error for {path}: {err}"
+        );
+    }
+}
+
+#[test]
+fn rejects_msys_style_and_relative_paths() {
+    for path in [
+        "/c/Program Files/Git/bin/bash.exe",
+        "/mnt/c/Program Files/Git/bin/bash.exe",
+        "bash.exe",
+        r"Git\bin\bash.exe",
+        // A POSIX shell path must never be mistaken for a configured Git Bash
+        // executable; this keeps Unix sessions on their upstream behavior.
+        "/bin/bash",
+    ] {
+        let err = classify_git_bash_path(std::path::Path::new(path))
+            .expect_err("non-native absolute path must be rejected");
+        assert_eq!(
+            err,
+            GitBashPathError::NotAnAbsoluteWindowsPath(path.to_string())
+        );
+    }
+}
+
+#[test]
+fn rejects_non_bash_and_non_git_layouts() {
+    let not_bash =
+        classify_git_bash_path(std::path::Path::new(r"C:\Program Files\Git\bin\git.exe"))
+            .expect_err("git.exe is not bash");
+    assert_eq!(
+        not_bash,
+        GitBashPathError::NotBash(r"C:\Program Files\Git\bin\git.exe".to_string())
+    );
+
+    // A `bash.cmd` is not Bash either: the extension check is strict.
+    let not_exe =
+        classify_git_bash_path(std::path::Path::new(r"C:\Program Files\Git\bin\bash.cmd"))
+            .expect_err("bash.cmd must not be accepted");
+    assert_eq!(
+        not_exe,
+        GitBashPathError::NotBash(r"C:\Program Files\Git\bin\bash.cmd".to_string())
+    );
+
+    // `bin\bash.exe` without an install root one level up has no layout at all.
+    let no_root = classify_git_bash_path(std::path::Path::new(r"bin\bash.exe"))
+        .expect_err("a bare bin path must be rejected");
+    assert_eq!(
+        no_root,
+        GitBashPathError::NotAnAbsoluteWindowsPath(r"bin\bash.exe".to_string())
+    );
+}
