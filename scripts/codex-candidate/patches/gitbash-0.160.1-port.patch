+#[test]
+fn capped_reader_limits_storage_and_remains_cancellable_with_open_writer() {
+    tokio::runtime::Builder::new_current_thread()
+        .enable_all()
+        .build()
+        .unwrap()
+        .block_on(async {
+            use tokio::io::AsyncWriteExt;
+            let (reader, mut writer) = tokio::io::duplex(1024);
+            let writer_task = tokio::spawn(async move {
+                writer
+                    .write_all(&vec![b'x'; IDENTITY_PROBE_MAX_OUTPUT_BYTES * 4])
+                    .await
+                    .unwrap();
+            });
+            let retained = drain_capped(reader).await.unwrap();
+            writer_task.await.unwrap();
+            assert_eq!(retained.len(), IDENTITY_PROBE_MAX_OUTPUT_BYTES);
+            let (reader, _inherited_writer) = tokio::io::duplex(64);
+            assert!(
+                tokio::time::timeout(Duration::from_millis(20), drain_capped(reader))
+                    .await
+                    .is_err()
+            );
+        });
+}
