+/// Windows-only: on a Unix host a `C:\...` string is a single path component, so
+/// it is classified as a non-Git layout before any disk access.
+#[cfg(windows)]
+#[test]
+fn resolve_reports_missing_file_without_falling_back() {
+    let missing = r"C:\definitely-missing-codex-stage2\Git\bin\bash.exe";
+    let err = resolve_configured_git_bash(std::path::Path::new(missing))
+        .expect_err("a missing file must be an error, never a fallback");
+    assert!(err.contains("CODEX_NATIVE_GIT_BASH_PATH"), "{err}");
+    // Canonicalization happens first, so a non-existent path is reported as
+    // missing rather than as a layout problem.
+    assert!(err.contains("does not exist"), "{err}");
+}
