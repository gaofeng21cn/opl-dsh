+/// Whether the *selected* Bash is Codex's Windows Git Bash support.
+///
+/// Codex's Git Bash support is full-access only: no Windows sandbox backend
+/// isolates a Git Bash child. Other Bash shells (Linux, WSL, remote
+/// environments) keep their existing semantics and are never refused here.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub(crate) enum BashAdmission {
+    /// The refused case: Git for Windows Bash selected while the base profile is
+    /// restricted.
+    RefusedGitBash,
+    /// Every other case: no Git Bash involved, or full access was granted.
+    NotRefused,
+}
+
+impl BashAdmission {
+    /// Decide admission for the resolved shell.
+    ///
+    /// `is_remote` is the execution environment's own locality, not the host
+    /// platform: a remote Linux environment must stay unrestricted even when
+    /// Codex runs on a Windows host.
+    fn evaluate(shell: &Shell, is_remote: bool, base_policy: CommandShellPolicy) -> Self {
+        if shell.shell_type != ShellType::Bash {
+            return Self::NotRefused;
+        }
+        if base_policy == CommandShellPolicy::FullAccess {
+            return Self::NotRefused;
+        }
+        if is_remote {
+            return Self::NotRefused;
+        }
+        let is_git_for_windows_bash = crate::git_bash::classify_git_bash_path(&shell.shell_path)
+            .is_ok_and(|classified| classified.path == shell.shell_path);
+        if is_git_for_windows_bash {
+            Self::RefusedGitBash
+        } else {
+            Self::NotRefused
+        }
+    }
+}
+
+/// The environment's **base** permission profile, as far as Git Bash admission is
+/// concerned.
+///
+/// This deliberately reads only the environment's base profile.
+/// `apply_granted_turn_permissions` takes `&TurnEnvironment` and returns a separate
+/// value, so it does not change what this reads. The conservative contract of this
+/// version is therefore: only a base profile of [`PermissionProfile::Disabled`]
+/// ("no outer sandbox") admits Git Bash, and per-turn/per-call additional
+/// permissions can never escalate a restricted session into full access.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub(crate) enum CommandShellPolicy {
+    /// The base sandbox is disabled, so Git Bash may run unsandboxed.
+    FullAccess,
+    /// Any other base profile: Git Bash commands are refused.
+    Restricted,
+}
+
+impl CommandShellPolicy {
+    /// True only for [`PermissionProfile::Disabled`], which means "do not apply
+    /// an outer sandbox". Every managed or externally enforced profile is
+    /// restricted, regardless of how permissive its filesystem rules look.
+    pub(crate) fn for_base_permission_profile(profile: &PermissionProfile) -> Self {
+        match profile {
+            PermissionProfile::Disabled => Self::FullAccess,
+            PermissionProfile::Managed { .. } | PermissionProfile::External { .. } => {
+                Self::Restricted
+            }
+        }
+    }
+}
