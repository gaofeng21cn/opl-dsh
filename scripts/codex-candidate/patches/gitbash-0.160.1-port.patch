+#[cfg(windows)]
+#[test]
+fn probe_checks_nonzero_exit_and_deadline() {
+    tokio::runtime::Builder::new_current_thread()
+        .enable_all()
+        .build()
+        .unwrap()
+        .block_on(async {
+            let mut failure = tokio::process::Command::new("cmd.exe");
+            failure.args(["/d", "/c", "exit 7"]);
+            assert!(
+                probe_identity(&mut failure, Duration::from_secs(3))
+                    .await
+                    .unwrap_err()
+                    .contains("exited")
+            );
+            let mut blocked = tokio::process::Command::new("powershell.exe");
+            blocked.args([
+                "-NoProfile",
+                "-NonInteractive",
+                "-Command",
+                "Start-Sleep -Seconds 10",
+            ]);
+            let start = std::time::Instant::now();
+            assert!(
+                probe_identity(&mut blocked, Duration::from_millis(50))
+                    .await
+                    .unwrap_err()
+                    .contains("timed out")
+            );
+            assert!(start.elapsed() < Duration::from_secs(3));
+        });
+}
