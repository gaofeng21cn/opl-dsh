+/// True only for the unambiguous WSL drive layout (`/mnt/c/...`, `/mnt/...`).
+///
+/// This is checked for Windows-local Git Bash commands so the model gets a clear
+/// error instead of a wrong path. Other `/x/...` roots are never reinterpreted.
+pub(crate) fn is_ambiguous_wsl_workdir(workdir: &str) -> bool {
+    let Some(rest) = workdir.strip_prefix('/') else {
+        return false;
+    };
+    let bytes = rest.as_bytes();
+    rest.eq_ignore_ascii_case("mnt")
+        || (bytes.len() >= 4 && bytes[..3].eq_ignore_ascii_case(b"mnt") && bytes[3] == b'/')
+}
+
+/// Convert a Git Bash style `/c/Users/me/dir` workdir into `C:\Users\me\dir`.
+///
+/// Returns `None` when the workdir is not an MSYS single-letter drive path, so the
+/// caller keeps the original value. Only the leading drive prefix is rewritten, so
+/// spaces, Unicode, and the rest of the path are preserved verbatim.
+pub(crate) fn convert_msys_drive_workdir(workdir: &str) -> Option<String> {
+    let rest = workdir.strip_prefix('/')?;
+    let bytes = rest.as_bytes();
+    // `/c/...` (single ASCII letter drive) is the MSYS drive form.
+    if bytes.len() >= 2 && bytes[0].is_ascii_alphabetic() && bytes[1] == b'/' {
+        let drive = (bytes[0] as char).to_ascii_uppercase();
+        let remainder = rest[1..].replace('/', "\\");
+        return Some(format!("{drive}:{remainder}"));
+    }
+    // `/c` with no trailing separator is still a drive root.
+    if bytes.len() == 1 && bytes[0].is_ascii_alphabetic() {
+        let drive = (bytes[0] as char).to_ascii_uppercase();
+        return Some(format!("{drive}:\\"));
+    }
+    None
+}
 
