{
  "name": "opl-dsh",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "OPL enhancements and one-click installation for official DeepSeek Harness Desktop",
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc -p tsconfig.host.json && tsc -p tsconfig.client.json",
    "test": "vitest run && node --test tests/*.test.mjs",
    "package": "npm run build && node package.mjs",
    "package:desktop": "npm run build && node desktop/build.mjs",
    "test:desktop": "cd desktop/bootstrap && go test ./..."
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-agent": "0.1.7-rc.2",
